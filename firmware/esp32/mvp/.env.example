# Plantilla para ogpass.xyz. Copiar a .env y reemplazar los marcadores.
# Nunca subir .env al repositorio. Sin credenciales MP, las recargas siguen deshabilitadas.
DEBUG=0
DOMAIN=ogpass.xyz
PUBLIC_URL=https://ogpass.xyz
ALLOWED_HOSTS=ogpass.xyz,localhost,127.0.0.1
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=ogpass
POSTGRES_USER=ogpass
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_MIGRATOR_PASSWORD
POSTGRES_SSLMODE=disable
POSTGRES_CONN_MAX_AGE=0
POSTGRES_DISABLE_SERVER_SIDE_CURSORS=1
# Claves distintas para cifrar referencias externas y generar búsquedas HMAC.
# No rotarlas sin un plan de migración de datos.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_CREDENTIAL_ENCRYPTION_KEY_AT_LEAST_32_CHARACTERS
CREDENTIAL_HMAC_KEY=REPLACE_WITH_DIFFERENT_RANDOM_CREDENTIAL_HMAC_KEY_AT_LEAST_32_CHARACTERS
# Credenciales de PRODUCCIÓN Mercado Pago Chile. Vacías = recargas deshabilitadas.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
# Consulta de saldo Movired: completar únicamente con endpoint y token entregados
# contractualmente por Movired. Vacías = integración pendiente, sin saldo ficticio.
MOVIRED_BALANCE_API_URL=
MOVIRED_BALANCE_API_TOKEN=
MOVIRED_ALLOWED_HOSTS=api.movired.cl,widget.movired.cl
