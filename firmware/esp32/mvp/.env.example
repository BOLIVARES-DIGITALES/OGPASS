# Plantilla para ogpass.xyz. Copiar a .env y reemplazar los marcadores.
# Nunca subir .env al repositorio. Sin credenciales MP, las recargas siguen deshabilitadas.
DEBUG=0
DOMAIN=ogpass.xyz
PUBLIC_URL=https://ogpass.xyz
ALLOWED_HOSTS=ogpass.xyz,localhost,127.0.0.1
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
POSTGRES_HOST=db
POSTGRES_DB=ogpass
POSTGRES_USER=ogpass
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_DATABASE_PASSWORD
POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_MIGRATOR_PASSWORD
# Credenciales de PRODUCCIÓN Mercado Pago Chile. Vacías = recargas deshabilitadas.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
