# Plantilla privada para ejecutar Django con PostgreSQL administrado por Supabase.
# Copiar a .env.supabase, chmod 600 y nunca subir el archivo completado.
DEBUG=0
DOMAIN=api.ogpass.xyz
PUBLIC_URL=https://api.ogpass.xyz
ALLOWED_HOSTS=api.ogpass.xyz,localhost,127.0.0.1
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_50_CHARACTERS

# Supabase Dashboard > Connect > Session pooler.
# No usar VITE_SUPABASE_PUBLISHABLE_KEY ni service_role como contraseña PostgreSQL.
POSTGRES_HOST=REPLACE_WITH_SUPABASE_SESSION_POOLER_HOST
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=REPLACE_WITH_SUPABASE_POOLER_USER
POSTGRES_PASSWORD=REPLACE_WITH_SUPABASE_DATABASE_PASSWORD
POSTGRES_SSLMODE=require
POSTGRES_CONN_MAX_AGE=0
POSTGRES_DISABLE_SERVER_SIDE_CURSORS=1

CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_CREDENTIAL_ENCRYPTION_KEY_AT_LEAST_32_CHARACTERS
CREDENTIAL_HMAC_KEY=REPLACE_WITH_DIFFERENT_RANDOM_CREDENTIAL_HMAC_KEY_AT_LEAST_32_CHARACTERS

MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
MP_COLLECTOR_ID=
MOVIRED_BALANCE_API_URL=
MOVIRED_BALANCE_API_TOKEN=
MOVIRED_ALLOWED_HOSTS=api.movired.cl,widget.movired.cl
